# Banco PostgreSQL (obrigatório)
# Produção: connection string do Neon (ou outro Postgres gerenciado)
# Local Docker: postgresql://tennis:tennis@localhost:5435/tennispool
NEON_CONNECTION_STRING=postgresql://user:password@host/database?sslmode=require

# E-mail — recuperação de senha (opcional em dev local; obrigatório em produção se usar reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
